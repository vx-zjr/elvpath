    {
      "id": "rust",
      "category": "languages",
      "name": { "en": "Rust", "zh": "Rust" },
      "summary": { "en": "Rust toolchain through rustup.", "zh": "通过 rustup 安装 Rust 工具链。" },
      "homepage": "https://www.rust-lang.org/tools/install",
      "supportedPlatforms": ["windows", "macos", "linux"],
      "tags": ["language", "compiler", "rustup"],
      "versions": [
        { "id": "stable", "label": "stable", "default": true },
        { "id": "beta", "label": "beta" },
        { "id": "nightly", "label": "nightly" }
      ],
      "sources": [
        { "kind": "official", "url": "https://www.rust-lang.org/tools/install" },
        { "kind": "mirror", "url": "https://mirrors.ustc.edu.cn/rust-static/" }
      ],
      "detection": [
        { "platforms": ["windows", "macos", "linux"], "kind": "path-command", "program": "rustc", "args": ["--version"], "sourceHint": "rustup/PATH" }
      ],
      "dependencies": [],
      "installSteps": [
        {
          "id": "rustup-windows",
          "platforms": ["windows"],
          "kind": "download",
          "title": { "en": "Download and run rustup-init.exe", "zh": "下载并运行 rustup-init.exe" },
          "url": "https://win.rustup.rs/x86_64",
          "mirrorUrl": "https://mirrors.ustc.edu.cn/rust-static/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe",
          "checksum": "official rustup release signature or SHA256",
          "command": "rustup-init.exe",
          "args": ["-y", "--default-toolchain", "stable"],
          "source": "official",
          "permissions": { "requiresAdmin": false, "reason": { "en": "Installs into the user profile.", "zh": "安装到当前用户目录。" } }
        },
        {
          "id": "rustup-unix",
          "platforms": ["macos", "linux"],
          "kind": "command",
          "title": { "en": "Run official rustup installer", "zh": "运行官方 rustup 安装脚本" },
          "url": "https://sh.rustup.rs",
          "mirrorUrl": "https://mirrors.ustc.edu.cn/rust-static/rustup/rustup-init.sh",
          "checksum": "official rustup release signature or SHA256",
          "command": "sh",
          "args": ["-c", "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"],
          "source": "official",
          "permissions": { "requiresAdmin": false, "reason": { "en": "Installs into the user profile.", "zh": "安装到当前用户目录。" } }
        }
      ],
      "configSteps": [
        {
          "target": "PATH",
          "action": "append",
          "value": "$HOME/.cargo/bin",
          "backupHint": { "en": "Back up the shell profile before modifying PATH.", "zh": "修改 PATH 前备份 shell profile。" },
          "rollback": { "en": "Remove $HOME/.cargo/bin from PATH.", "zh": "从 PATH 中移除 $HOME/.cargo/bin。" }
        }
      ]
    },
