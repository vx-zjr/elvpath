      "homepage": "https://nodejs.org/",
      "supportedPlatforms": ["windows", "macos", "linux"],
      "tags": ["javascript", "runtime", "npm"],
      "versions": [
        { "id": "22", "label": "22 LTS", "default": true },
        { "id": "24", "label": "24 Current" }
      ],
      "sources": [
        { "kind": "official", "url": "https://nodejs.org/en/download" },
        { "kind": "mirror", "url": "https://npmmirror.com/mirrors/node/" }
      ],
      "detection": [
        { "platforms": ["windows", "macos", "linux"], "kind": "path-command", "program": "node", "args": ["--version"], "sourceHint": "PATH" }
      ],
      "dependencies": [],
      "installSteps": [
        {
          "id": "node-windows",
          "platforms": ["windows"],
          "kind": "download",
          "title": { "en": "Download official Windows MSI", "zh": "下载官方 Windows MSI" },
          "url": "https://nodejs.org/dist/latest-v22.x/node-v22.x-x64.msi",
          "mirrorUrl": "https://npmmirror.com/mirrors/node/latest-v22.x/node-v22.x-x64.msi",
          "checksum": "SHASUMS256.txt from nodejs.org",
          "command": "msiexec",
          "args": ["/i", "node-v22.x-x64.msi", "/passive"],
          "source": "official",
          "permissions": { "requiresAdmin": true, "reason": { "en": "MSI installs system-wide.", "zh": "MSI 会安装到系统范围。" } }
        },
        {
          "id": "node-unix",
          "platforms": ["macos", "linux"],
          "kind": "download",
          "title": { "en": "Download official tarball", "zh": "下载官方 tarball" },
          "url": "https://nodejs.org/dist/latest-v22.x/node-v22.x-linux-x64.tar.xz",
          "mirrorUrl": "https://npmmirror.com/mirrors/node/latest-v22.x/node-v22.x-linux-x64.tar.xz",
          "checksum": "SHASUMS256.txt from nodejs.org",
          "command": "tar",
          "args": ["-xf", "node-v22.x-linux-x64.tar.xz"],
          "source": "official",
          "permissions": { "requiresAdmin": false, "reason": { "en": "Can install into a user-owned tool directory.", "zh": "可安装到用户拥有的工具目录。" } }
        }
      ],
      "configSteps": [
        {
          "target": "PATH",
          "action": "append",
          "value": "$ELVPATH_TOOLS/node/bin",
          "backupHint": { "en": "Back up PATH before adding Node.js.", "zh": "添加 Node.js 前备份 PATH。" },
          "rollback": { "en": "Remove the ElvPath Node.js bin directory from PATH.", "zh": "从 PATH 中移除 ElvPath Node.js bin 目录。" }
        }
      ]
    },
